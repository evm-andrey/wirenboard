[
  {
    "id": "thermostat-bedroom-temperature",
    "read": {
      "enable": true,
      "channel": "WB_thermostat_bedroom/local_temperature",
      "value": "(val !== null && val !== undefined && val !== '' && isFinite(Number(val))) ? Number(val).toFixed(1) + ' °C' : 'Нет данных'"
    }
  },
  {
    "id": "thermostat-bedroom-sensor-label",
    "read": {
      "enable": true,
      "channel": "Thermostat_bedroom/sensor",
      "value": "val === 'OU' ? 'Температура пола · выносной датчик' : val === 'IN' ? 'Температура воздуха · встроенный' : val === 'AL' ? 'Воздух · ограничение по датчику пола' : 'Датчик термостата · нет данных'"
    }
  },
  {
    "id": "thermostat-bedroom-setpoint",
    "read": {
      "enable": true,
      "channel": "WB_thermostat_bedroom/heating_setpoint_state",
      "value": "(val !== null && val !== undefined && val !== '' && isFinite(Number(val))) ? Number(val).toFixed(1) + ' °C' : 'Нет данных'"
    }
  },
  {
    "id": "thermostat-bedroom-state",
    "read": {
      "enable": true,
      "channel": "WB_thermostat_bedroom/running_state",
      "value": "val === 'heat' ? 'Нагревает' : val === 'idle' ? 'Ожидание' : val === 'off' ? 'Выключено' : 'Нет данных'"
    }
  },
  {
    "id": "thermostat-bedroom-state-bg",
    "style": {
      "enable": true,
      "channel": "WB_thermostat_bedroom/running_state",
      "value": "val === 'heat' ? ';fill:#fff1df' : val === 'idle' ? ';fill:#edf7f1' : ';fill:#eef3f9'"
    }
  },
  {
    "id": "thermostat-bedroom-set-20",
    "write": {
      "enable": true,
      "channel": "WB_thermostat_bedroom/current_heating_setpoint",
      "value": {
        "on": "20",
        "off": "20"
      },
      "check": false
    },
    "style": {
      "enable": true,
      "channel": "WB_thermostat_bedroom/heating_setpoint_state",
      "value": "(val !== null && val !== undefined && Number(val) === 20) ? ';fill:#cfe6fa;stroke:#338ad0' : ';fill:#eef3f9;stroke:#dfe7ef'"
